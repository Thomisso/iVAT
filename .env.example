# Written by `npm run db:start` for the stack of this checkout. The values below are
# the main checkout's local defaults.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Direct Postgres connection used by the worker's job queue (pg-boss).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The worker's service_role key. It bypasses RLS, so only the worker uses it.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# AI provider mode for Split and Extract: `fake` answers from a script without
# sending Documents anywhere; `platform` routes each Company to its consented
# provider and resolves models and encrypted keys from SuperAdmin settings.
AI_PROVIDER=fake

# Used only by `npm run test:contract:anthropic`; never by the worker.
ANTHROPIC_CONTRACT_API_KEY=
ANTHROPIC_CONTRACT_MODEL=

# Used only by `npm run test:contract:openai`; never by the worker.
OPENAI_CONTRACT_API_KEY=
OPENAI_CONTRACT_MODEL=

# Optional: enable working Google sign-in in the local Supabase stack. Without
# these, the stack still starts but Google rejects the placeholder credentials.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
