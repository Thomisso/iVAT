# Written by `npm run db:start` for the stack of this checkout. The values below are
# endpoint defaults below contain no credentials. Run db:start to generate
# this checkout's actual keys in the ignored .env.local file.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional private HTTP transport for server requests and the worker in Docker.
# Keep NEXT_PUBLIC_SUPABASE_URL public: cookies, OAuth and signed links use it.
# Omit this for host-run local development; an internal failure never falls back.
# SUPABASE_INTERNAL_URL=http://gateway:8000

# Canonical application origin and the exact Auth callback bases that this
# application may request. Production Supabase Auth must allow the same callback.
APP_ORIGIN=http://127.0.0.1:3000
AUTH_REDIRECT_ALLOWLIST=http://127.0.0.1:3000/auth/callback

# Direct Postgres connection used by the worker's job queue (pg-boss).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Private service key: worker processing and the scoped server Auth adapter only.
SUPABASE_SECRET_KEY=

# Local invitation capture; db:start manages these against this checkout's Mailpit.
# Production uses the same managed SMTP credentials as Auth, with TLS and authentication.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_LOCAL_CAPTURE=true
SMTP_ADMIN_EMAIL=noreply@ivat.cz

# AI provider mode for Split and Extract: `fake` answers from a script without
# sending Documents anywhere; `platform` routes each Company through its
# SuperAdmin-assigned AI Configuration and resolves its models and encrypted key.
AI_PROVIDER=fake

# Registry and exchange-rate selection is independent of AI_PROVIDER. Unset
# values use the ordinary live adapters (`adis` and `cnb`). Set both to `fake`
# for deterministic local/demo work; the E2E runner selects these explicitly.
VAT_REGISTRY_PROVIDER=adis
EXCHANGE_RATE_PROVIDER=cnb

# Used only by `npm run test:contract:anthropic`; never by the worker.
ANTHROPIC_CONTRACT_API_KEY=
ANTHROPIC_CONTRACT_MODEL=

# Used only by `npm run test:contract:openai`; never by the worker.
OPENAI_CONTRACT_API_KEY=
OPENAI_CONTRACT_MODEL=

# Used only by `npm run evaluate:extraction`. The command reuses each
# provider's contract key/model above unless a pipeline-specific model is set.
EVALUATION_PROVIDERS=
ANTHROPIC_EVALUATION_SPLIT_MODEL=
ANTHROPIC_EVALUATION_EXTRACT_MODEL=
OPENAI_EVALUATION_SPLIT_MODEL=
OPENAI_EVALUATION_EXTRACT_MODEL=

# Optional: enable working Google sign-in in the local Supabase stack. Without
# these, keep [auth.external.google] enabled=false in supabase/config.toml.
# Set enabled=true only after supplying both real credentials. No placeholder
# credentials are injected by startup; public signup stays disabled.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
