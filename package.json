{
  "name": "ivat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:start": "node scripts/supabase.mjs start",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:migrate": "node scripts/supabase.mjs migration up",
    "db:reset": "node scripts/supabase.mjs db reset",
    "db:types": "node scripts/supabase.mjs gen types typescript --local > src/lib/database.types.ts",
    "dev": "next dev",
    "worker": "tsx watch --env-file=.env.local worker/index.ts",
    "dev:seed": "tsx --env-file=.env.local scripts/dev-seed.ts",
    "demo": "node scripts/demo.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:watch": "vitest",
    "test:contract:ares": "ARES_CONTRACT_TEST=1 vitest run tests/contract/ares.test.ts",
    "test:contract:adis": "ADIS_CONTRACT_TEST=1 vitest run tests/contract/adis-vat-registry.test.ts",
    "test:contract:cnb": "CNB_CONTRACT_TEST=1 vitest run tests/contract/cnb-rates.test.ts",
    "test:contract:anthropic": "ANTHROPIC_CONTRACT_TEST=1 vitest run tests/contract/anthropic.test.ts",
    "test:contract:openai": "OPENAI_CONTRACT_TEST=1 vitest run tests/contract/openai.test.ts",
    "evaluate:extraction": "tsx scripts/evaluate-extraction.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "fflate": "^0.8.3",
    "libxml2-wasm": "^0.7.2",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^12.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
